# Database
DATABASE_URL=postgresql+asyncpg://recruflow:recruflow@db:5432/recruflow

# Ollama (local LLM runtime)
OLLAMA_BASE_URL=http://ollama:11434
# llama3.1:8b: chosen for the CV extraction chain (P2US19) to fit this dev
# machine's 8GB VRAM budget; see docs/adr/0011-ollama-model-for-cv-extraction.md
OLLAMA_MODEL=llama3.1:8b
# llama3.1:8b: reused for the LangChain Matcher (P3US22) — see
# docs/adr/0013-ollama-model-for-langchain-matcher.md
MATCHER_OLLAMA_MODEL=llama3.1:8b

# SMTP (used by P4US4 application send)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# SOLID.Jobs
SOLID_JOBS_CAMPAIGN=recruflow

# Batch scoring (BUG16): unscored offers processed per ingestion/scheduler run,
# so a single ingest can't block on an unbounded backlog
BATCH_SCORING_LIMIT=20

# App
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
CORS_ALLOW_ORIGIN=http://localhost:5173

# Swarm / Send Queue (P5)
SWARM_GRADE_THRESHOLD=B
SEND_QUEUE_INTER_SEND_DELAY_SECONDS=30
SEND_QUEUE_DAILY_CAP=20
FORM_FILL_DAILY_CAP=5
