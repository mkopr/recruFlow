# Database
DATABASE_URL=postgresql+asyncpg://recruflow:recruflow@db:5432/recruflow

# Ollama (local LLM runtime)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.3:70b

# SMTP (used by P4US4 application send)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# SOLID.Jobs / sjctl
SJCTL_CAMPAIGN=recruflow

# App
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000

# Swarm / Send Queue (P5)
SWARM_GRADE_THRESHOLD=B
SEND_QUEUE_INTER_SEND_DELAY_SECONDS=30
SEND_QUEUE_DAILY_CAP=20
FORM_FILL_DAILY_CAP=5
