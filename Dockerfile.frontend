FROM node:22-alpine AS dev

RUN corepack enable
WORKDIR /app

COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY frontend/ .

EXPOSE 5173

# --host is required: Vite's dev server binds 127.0.0.1 by default, which is
# unreachable from outside the container. Invoked via `pnpm exec` (not
# `pnpm dev --`) because pnpm's script-shorthand form forwards a literal `--`
# to Vite's CLI, which then silently ignores --host.
CMD ["pnpm", "exec", "vite", "--host", "0.0.0.0"]

FROM node:22-alpine AS build

RUN corepack enable
WORKDIR /app

COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY frontend/ .
RUN pnpm build

FROM nginx:1.27-alpine AS production

COPY --from=build /app/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
